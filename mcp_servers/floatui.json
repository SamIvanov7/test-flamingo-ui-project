{
  "title": "FloatUI-MCP",
  "description": "Responsive Tailwind components",
  "system_prompt": "Импортируй snippets из FloatUI, перерабатывай под React.\nДобавь prop `as` для кастомного рендер-root (если ссылка → `<a>`).",
  "example_user": "Hero-секция + CTA с изображением справа.",
  "example_assistant": "```tsx\ninterface HeroSectionProps {\n  title: string;\n  description: string;\n  ctaText: string;\n  ctaHref: string;\n  imageUrl: string;\n}\n\nconst HeroSection = ({ title, description, ctaText, ctaHref, imageUrl }: HeroSectionProps) => (\n  <section className=\"max-w-screen-xl mx-auto px-4 py-28 gap-12 text-gray-600 overflow-hidden md:px-8 md:flex\">\n    <div className=\"flex-none space-y-5 max-w-xl\">\n      <a\n        href=\"#\"\n        className=\"inline-flex gap-x-6 items-center rounded-full p-1 pr-6 border text-sm font-medium duration-150 hover:bg-white\"\n      >\n        <span className=\"inline-block rounded-full px-3 py-1 bg-indigo-600 text-white\">\n          News\n        </span>\n        <p className=\"flex items-center\">\n          Read the launch post from here\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" className=\"w-5 h-5\">\n            <path fillRule=\"evenodd\" d=\"M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z\" clipRule=\"evenodd\" />\n          </svg>\n        </p>\n      </a>\n      <h1 className=\"text-4xl text-gray-800 font-extrabold sm:text-5xl\">\n        {title}\n      </h1>\n      <p>\n        {description}\n      </p>\n      <div className=\"flex items-center gap-x-3 sm:text-sm\">\n        <a\n          href={ctaHref}\n          className=\"flex items-center justify-center gap-x-1 py-2 px-4 text-white font-medium bg-gray-800 duration-150 hover:bg-gray-700 active:bg-gray-900 rounded-full md:inline-flex\"\n        >\n          {ctaText}\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" className=\"w-5 h-5\">\n            <path fillRule=\"evenodd\" d=\"M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z\" clipRule=\"evenodd\" />\n          </svg>\n        </a>\n        <a\n          href=\"#\"\n          className=\"flex items-center justify-center gap-x-1 py-2 px-4 text-gray-700 hover:text-gray-900 font-medium duration-150 md:inline-flex\"\n        >\n          Contact sales\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" className=\"w-5 h-5\">\n            <path fillRule=\"evenodd\" d=\"M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z\" clipRule=\"evenodd\" />\n          </svg>\n        </a>\n      </div>\n    </div>\n    <div className=\"flex-1 hidden md:block\">\n      <img\n        src={imageUrl}\n        className=\"lg:max-w-2xl\"\n        alt=\"Hero illustration\"\n      />\n    </div>\n  </section>\n);\n```"
}